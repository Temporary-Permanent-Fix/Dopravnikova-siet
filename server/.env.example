# The server starts in mock mode and does not need any credentials.
PORT=5173
# The server accepts session API keys. Keep it local by default; set
# HOST=0.0.0.0 only behind an authenticated/reverse-proxied deployment.
HOST=127.0.0.1
LIVE_DATA_MODE=mock
LIVE_WINDOW_SECONDS=60
LIVE_POLL_INTERVAL_MS=5000
ELASTICSEARCH_TIMEOUT_MS=8000
ELASTICSEARCH_RESULT_LIMIT=1000

# Fill these only for the read-only Elasticsearch live mode. Never commit a
# populated server/.env file and never expose these values to the frontend.
# ELASTICSEARCH_URL=https://elasticsearch.internal.example
# ELASTICSEARCH_API_KEY=replace-with-read-only-api-key
# ELASTICSEARCH_INDEX=your-stable-data-stream-or-alias
# ELASTICSEARCH_NAMESPACE=logistics-robotics-prd-tmslct
# ELASTICSEARCH_CONTAINER=tmsagent
# Field used for the time range filter/sort. Only set this if Kibana
# Discover shows a different time field than "@timestamp" for your index
# (confirm via the index mapping first).
# ELASTICSEARCH_TIMESTAMP_FIELD=@timestamp

# A user can also configure a read-only Elasticsearch connection from the
# Live dialog. That URL/index/key live only in the current browser session
# and server memory; they are never written into this file.
