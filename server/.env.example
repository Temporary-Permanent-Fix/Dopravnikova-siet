# No credentials needed. The server only serves the static frontend and
# /api/health, /api/version — live Kibana data comes from the operator's own
# logged-in Kibana session (embedded tab in Electron, or browser-extension),
# never from an API key.
PORT=5173
# Keep it local by default; set HOST=0.0.0.0 only behind an
# authenticated/reverse-proxied deployment.
HOST=127.0.0.1
